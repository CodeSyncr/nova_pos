<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NovaPOS.Desktop.Views"
        xmlns:ctl="clr-namespace:NovaPOS.Desktop.Controls"
        x:Class="NovaPOS.Desktop.MainWindow"
        Title="POS — Pizzeria Da Cafe"
        Icon="/Assets/logo.png"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        Background="#0A0A0A"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen">

    <!--
      Shell mirrors src/app/(dashboard)/layout.tsx: a rail that expands on hover
      and floats above the page, with the page itself offset by the collapsed
      rail width (lg:pl-[92px] on web).
    -->
    <ctl:ShellHost ClipToBounds="True">
        <!-- Page host -->
        <ctl:ShellHost Name="ContentArea" Margin="76,0,0,0" ClipToBounds="True">
            <views:HomePage Name="PageHome" IsVisible="False" />
            <views:POSPage Name="PagePOS" IsVisible="False" />
            <views:OrdersPage Name="PageOrders" IsVisible="False" />
            <views:SettingsPage Name="PageSettings" IsVisible="False" />
        </ctl:ShellHost>

        <!-- Login takes over the whole window, exactly like the web /login route -->
        <views:LoginPage Name="PageLogin" />

        <!-- Rail -->
        <Border Name="Sidebar"
                HorizontalAlignment="Left"
                Width="76"
                ClipToBounds="True"
                Background="#0C0C0C"
                BorderBrush="{StaticResource White10Brush}"
                BorderThickness="0,0,1,0"
                BoxShadow="0 20 80 0 #B303040C"
                Padding="16,24"
                PointerEntered="OnSidebarEnter"
                PointerExited="OnSidebarExit">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>

            <DockPanel LastChildFill="False">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="2,0,0,32">
                    <Border Width="36" Height="36"
                            CornerRadius="16"
                            ClipToBounds="True"
                            BorderBrush="{StaticResource White10Brush}"
                            BorderThickness="1"
                            BoxShadow="0 10 30 0 #59E0342A">
                        <Image Source="/Assets/favicon.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Name="BrandText"
                                VerticalAlignment="Center"
                                Spacing="1"
                                IsVisible="False">
                        <TextBlock Text="POS"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Name="LblCafe"
                                   Classes="cursive"
                                   FontSize="14"
                                   Text="pizzeria da cafe" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Button Name="BtnNavHome" Classes="nav" Click="OnNavHome" ToolTip.Tip="Home  (F1)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ctl:Icon Data="{StaticResource Icon.LayoutDashboard}" />
                            <TextBlock Name="LblNavHome" Text="Home" VerticalAlignment="Center" IsVisible="False" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnNavPOS" Classes="nav" Click="OnNavPOS" ToolTip.Tip="POS  (F2)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ctl:Icon Data="{StaticResource Icon.SquareTerminal}" />
                            <TextBlock Name="LblNavPOS" Text="POS" VerticalAlignment="Center" IsVisible="False" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnNavOrders" Classes="nav" Click="OnNavOrders" ToolTip.Tip="Orders  (F3)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ctl:Icon Data="{StaticResource Icon.Receipt}" />
                            <TextBlock Name="LblNavOrders" Text="Orders" VerticalAlignment="Center" IsVisible="False" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnNavSettings" Classes="nav" Click="OnNavSettings" ToolTip.Tip="Settings  (F4)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ctl:Icon Data="{StaticResource Icon.Settings}" />
                            <TextBlock Name="LblNavSettings" Text="Settings" VerticalAlignment="Center" IsVisible="False" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0">
                        <Ellipse Name="StatusDot"
                                 Width="7" Height="7"
                                 Fill="#34D399"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="Terminal online" />
                        <TextBlock Name="LblStatus"
                                   Text="Terminal online"
                                   FontSize="11"
                                   Foreground="{StaticResource White35Brush}"
                                   VerticalAlignment="Center"
                                   IsVisible="False" />
                    </StackPanel>

                    <Button Name="BtnLogout"
                            Classes="danger"
                            CornerRadius="12"
                            Padding="12,10"
                            HorizontalContentAlignment="Left"
                            ToolTip.Tip="Sign out"
                            Click="OnLogout">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ctl:Icon Data="{StaticResource Icon.LogOut}" />
                            <TextBlock Name="LblLogout"
                                       Text="Logout"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       IsVisible="False" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Biometric Setup Modal Popup -->
        <Border Name="BiometricSetupOverlay"
                IsVisible="False"
                Background="#CC000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border CornerRadius="28"
                    Width="460"
                    Padding="32"
                    Background="#121212"
                    BorderBrush="#E0342A"
                    BorderThickness="1.5"
                    BoxShadow="0 30 100 0 #D0000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <Border Width="64" Height="64"
                            CornerRadius="20"
                            Background="#20E0342A"
                            HorizontalAlignment="Center">
                        <ctl:Icon Data="{StaticResource Icon.Sparkles}" Width="32" Height="32" Foreground="#E0342A" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Setup Biometric Sign-In?"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use Windows Hello, Fingerprint or Facial Recognition for instant sign-in next time you launch NovaPOS."
                                   FontSize="13" Foreground="#A3A3A3"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <Button Name="BtnEnableBiometricsNow"
                                Content="Enable Windows Hello / Fingerprint"
                                Classes="brand"
                                Height="44"
                                CornerRadius="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                Click="OnEnableBiometricsNow" />
                        <Button Name="BtnSkipBiometrics"
                                Content="Skip for Now"
                                Classes="secondary"
                                Height="40"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                Click="OnSkipBiometrics" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Toast stack sits above every page, like the web ToastProvider -->
        <ctl:ToastHost />
    </ctl:ShellHost>
</Window>
