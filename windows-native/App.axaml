<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaPOS.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>

    <Application.Resources>
        <!-- Brand Colors -->
        <Color x:Key="BrandRed">#E0342A</Color>
        <Color x:Key="BrandRedHover">#C42A21</Color>
        <Color x:Key="BgBlack">#0A0A0A</Color>
        <Color x:Key="BgSurface">#121212</Color>
        <Color x:Key="BgCard">#101010</Color>
        <Color x:Key="BgElevated">#181818</Color>
        <Color x:Key="BgInput">#141414</Color>
        <Color x:Key="BorderSubtle">#242424</Color>
        <Color x:Key="TextMuted">#94A3B8</Color>
        <Color x:Key="TextDim">#4D4D4D</Color>

        <SolidColorBrush x:Key="BrandRedBrush" Color="#E0342A" />
        <SolidColorBrush x:Key="BrandRedHoverBrush" Color="#C42A21" />
        <SolidColorBrush x:Key="BgBlackBrush" Color="#0A0A0A" />
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="#121212" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#101010" />
        <SolidColorBrush x:Key="BgElevatedBrush" Color="#181818" />
        <SolidColorBrush x:Key="BgInputBrush" Color="#141414" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#242424" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#4D4D4D" />
    </Application.Resources>
</Application>
