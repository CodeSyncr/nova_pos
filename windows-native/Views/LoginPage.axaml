<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:NovaPOS.Desktop.Controls"
             x:Class="NovaPOS.Desktop.Views.LoginPage"
             Background="#0A0A0A"
             Foreground="White">

    <!--
      Mirrors src/app/(auth)/login/page.tsx: the storefront photograph fills the
      left half, the form sits centred in the right half, and the image fades
      into the form column.
    -->
    <Grid ColumnDefinitions="*,*">

        <!--
          Hero fills the left column and fades into the form column. Painted as a
          brush rather than an Image so the photograph's intrinsic size can't
          inflate the star column.
        -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <ImageBrush Source="/Assets/login_bg.jpg"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center" />
            </Border.Background>
            <Border Background="{StaticResource LoginScrimBrush}" />
        </Border>

        <!-- Form column -->
        <Panel Grid.Column="1" Background="#0A0A0A">
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,32">
                    <Border Width="40" Height="40"
                            CornerRadius="16"
                            ClipToBounds="True"
                            BorderBrush="{StaticResource White10Brush}"
                            BorderThickness="1"
                            BoxShadow="0 10 30 0 #59E0342A">
                        <Image Source="/Assets/favicon.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="pizzeria da cafe"
                               Classes="cursive"
                               FontSize="24"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Sign in"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Text="Welcome back to Pizzeria Da Cafe"
                           FontSize="13"
                           Foreground="{StaticResource White40Brush}"
                           Margin="0,4,0,26" />

                <!-- Email -->
                <TextBlock Text="EMAIL" Classes="label" Margin="0,0,0,6" />
                <TextBox Name="TxtEmail"
                         Watermark="you@pizzeriadacafe.com"
                         Padding="12,12"
                         KeyDown="OnFieldKeyDown">
                    <TextBox.InnerLeftContent>
                        <ctl:Icon Data="{StaticResource Icon.Mail}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource White30Brush}"
                                  Margin="2,0,10,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- Password -->
                <TextBlock Text="PASSWORD" Classes="label" Margin="0,16,0,6" />
                <TextBox Name="TxtPassword"
                         Watermark="••••••••"
                         PasswordChar="•"
                         Padding="12,12"
                         KeyDown="OnFieldKeyDown">
                    <TextBox.InnerLeftContent>
                        <ctl:Icon Data="{StaticResource Icon.Lock}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource White30Brush}"
                                  Margin="2,0,10,0" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Button Name="BtnReveal"
                                Classes="step"
                                Width="28" Height="28"
                                Margin="6,0,0,0"
                                Click="OnToggleReveal"
                                ToolTip.Tip="Show password">
                            <ctl:Icon Name="IcoReveal"
                                      Data="{StaticResource Icon.Eye}"
                                      Width="16" Height="16" />
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>

                <!-- Error -->
                <Border Name="ErrorBox"
                        IsVisible="False"
                        Margin="0,16,0,0"
                        CornerRadius="10"
                        Padding="12,8"
                        Background="{StaticResource Brand10Brush}"
                        BorderBrush="{StaticResource Brand30Brush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:Icon Data="{StaticResource Icon.CircleAlert}"
                                  Width="14" Height="14"
                                  Foreground="#FCA5A5"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0" />
                        <TextBlock Name="LblError"
                                   FontSize="12"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"
                                   MaxWidth="300" />
                    </StackPanel>
                </Border>

                <!-- Submit -->
                <Border Margin="0,20,0,0"
                        CornerRadius="12"
                        BoxShadow="0 10 30 -8 #99E0342A">
                    <Button Name="BtnLogin"
                            Classes="brand"
                            Height="46"
                            CornerRadius="12"
                            FontSize="13"
                            HorizontalAlignment="Stretch"
                            Click="OnLoginClick">
                        <StackPanel Name="LoginContent" Orientation="Horizontal" Spacing="8">
                            <TextBlock Name="LblLogin" Text="Sign in" VerticalAlignment="Center" />
                            <ctl:Icon Name="IcoLogin"
                                      Data="{StaticResource Icon.ArrowRight}"
                                      Width="16" Height="16" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Divider -->
                <Grid Margin="0,22,0,0" ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="0" Height="1" Background="{StaticResource White10Brush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="NATIVE TERMINAL"
                               FontSize="10"
                               FontWeight="Medium"
                               LetterSpacing="1.4"
                               Foreground="{StaticResource White30Brush}"
                               Margin="12,0" />
                    <Border Grid.Column="2" Height="1" Background="{StaticResource White10Brush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Device note -->
                <Border Margin="0,18,0,0"
                        CornerRadius="12"
                        Padding="14,12"
                        Background="{StaticResource White03Brush}"
                        BorderBrush="{StaticResource White08Brush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ctl:Icon Data="{StaticResource Icon.Printer}"
                                  Width="18" Height="18"
                                  Foreground="{StaticResource BrandBrush}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Direct hardware session"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource White80Brush}" />
                            <TextBlock Text="Thermal printer and cash drawer are driven locally."
                                       FontSize="11"
                                       Foreground="{StaticResource White35Brush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="270" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
