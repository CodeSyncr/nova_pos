<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaPOS.Desktop.Views.LoginPage"
             Background="#0A0A0A">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#121212"
                CornerRadius="20"
                BorderBrush="#242424"
                BorderThickness="1"
                Width="420" Padding="40">
            <StackPanel Spacing="8">
                <!-- Logo -->
                <TextBlock Text="N" FontSize="32" FontWeight="Bold"
                           Foreground="#E0342A" Margin="0,0,0,8" />

                <TextBlock Text="Sign In" FontSize="22" FontWeight="Bold"
                           Foreground="White" />

                <TextBlock Text="Connect native POS to your cloud backend"
                           Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16" />

                <!-- Email -->
                <TextBlock Text="EMAIL" FontSize="10" FontWeight="SemiBold"
                           Foreground="#94A3B8" Margin="0,8,0,4" />
                <TextBox x:Name="TxtEmail"
                         Text="yashkumar12125@gmail.com"
                         Background="#141414"
                         BorderBrush="#242424"
                         Foreground="White"
                         CornerRadius="14"
                         Padding="14,10"
                         FontSize="13" />

                <!-- Password -->
                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold"
                           Foreground="#94A3B8" Margin="0,12,0,4" />
                <TextBox x:Name="TxtPassword"
                         Text="Kubernetes#0641"
                         PasswordChar="●"
                         Background="#141414"
                         BorderBrush="#242424"
                         Foreground="White"
                         CornerRadius="14"
                         Padding="14,10"
                         FontSize="13" />

                <!-- Error label -->
                <TextBlock x:Name="LblError"
                           Foreground="#EF4444"
                           FontSize="11"
                           IsVisible="False"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />

                <!-- Submit -->
                <Button x:Name="BtnLogin"
                        Content="Authenticate"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="48"
                        Background="#E0342A"
                        Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        CornerRadius="14"
                        Margin="0,16,0,0"
                        Cursor="Hand"
                        Click="OnLoginClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
