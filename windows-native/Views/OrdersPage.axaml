<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:NovaPOS.Desktop.Controls"
             x:Class="NovaPOS.Desktop.Views.OrdersPage"
             Background="#0A0A0A"
             Foreground="White">

    <!--
      Mirrors src/app/(dashboard)/orders/page.tsx: header, search, status filter
      row, then the responsive card grid with the status accent bar on top.
    -->
    <DockPanel Margin="32,26,32,24">

        <StackPanel DockPanel.Dock="Top" Spacing="18" Margin="0,0,0,20">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Orders"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Name="LblSubtitle"
                               Text="Live order feed from every channel"
                               FontSize="13"
                               Foreground="{StaticResource White40Brush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border CornerRadius="100"
                            Padding="12,6"
                            Background="{StaticResource White03Brush}"
                            BorderBrush="{StaticResource White08Brush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                            <TextBlock Name="LblLiveCount"
                                       Text="0 active"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource White60Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Name="BtnRefresh" Classes="outline" Padding="14,9" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:Icon Name="IcoRefresh"
                                      Data="{StaticResource Icon.RefreshCw}"
                                      Width="15" Height="15" />
                            <TextBlock Name="LblRefresh"
                                       Text="Refresh"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Time Range & Search Row -->
            <Grid ColumnDefinitions="Auto,16,*">
                <!-- Time Range Segment Picker -->
                <Border CornerRadius="16"
                        Padding="4"
                        Background="{StaticResource White02Brush}"
                        BorderBrush="{StaticResource White08Brush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="Auto,4,Auto,4,Auto,4,Auto,4,Auto">
                        <Button Name="BtnDateToday" Grid.Column="0" Classes="segment active"
                                Content="Today" Padding="16,8" Click="OnSelectDateToday" />
                        <Button Name="BtnDateYesterday" Grid.Column="2" Classes="segment"
                                Content="Yesterday" Padding="16,8" Click="OnSelectDateYesterday" />
                        <Button Name="BtnDateWeek" Grid.Column="4" Classes="segment"
                                Content="This Week" Padding="16,8" Click="OnSelectDateWeek" />
                        <Button Name="BtnDateMonth" Grid.Column="6" Classes="segment"
                                Content="This Month" Padding="16,8" Click="OnSelectDateMonth" />
                        <Button Name="BtnDateAll" Grid.Column="8" Classes="segment"
                                Content="All Time" Padding="16,8" Click="OnSelectDateAll" />
                    </Grid>
                </Border>

                <!-- Search -->
                <TextBox Name="TxtSearch"
                         Grid.Column="2"
                         Watermark="Search by order id, customer or table…"
                         CornerRadius="16"
                         Padding="14,11"
                         Background="{StaticResource White03Brush}"
                         BorderBrush="{StaticResource White08Brush}"
                         MaxWidth="420"
                         HorizontalAlignment="Right">
                    <TextBox.InnerLeftContent>
                        <ctl:Icon Data="{StaticResource Icon.Search}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource White30Brush}"
                                  Margin="2,0,10,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <!-- Status filters -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="FiltersPanel" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>
        </StackPanel>

        <!-- Cards -->
        <Panel>
            <ScrollViewer Name="OrdersScroller" VerticalScrollBarVisibility="Auto">
                <ctl:ResponsiveGrid Name="OrdersPanel"
                                    MinItemWidth="360"
                                    Gap="16"
                                    Margin="0,0,0,8" />
            </ScrollViewer>

            <Border Name="OrdersEmpty"
                    IsVisible="False"
                    CornerRadius="28"
                    BorderThickness="1"
                    BorderBrush="{StaticResource White20Brush}"
                    Background="{StaticResource White03Brush}"
                    VerticalAlignment="Top"
                    Padding="40,44">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <ctl:Icon Data="{StaticResource Icon.Receipt}"
                              Width="38" Height="38"
                              Foreground="{StaticResource White50Brush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Name="LblEmptyTitle"
                               Text="No orders yet"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Orders placed through POS will appear here"
                               FontSize="13"
                               Foreground="{StaticResource White60Brush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!--
              ══ Order editor ══════════════════════════════════════════════════
              Edits a copy of the order (OrderEditDraft); nothing reaches the
              server until Save, so closing the sheet discards the changes.
            -->
            <Panel Name="EditOverlay" IsVisible="False">
                <Border Background="#99000000" PointerPressed="OnEditBackdrop" />

                <Border Width="720" MaxHeight="640"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="28"
                        ClipToBounds="True"
                        Background="#0A0A0A"
                        BorderBrush="{StaticResource White10Brush}"
                        BorderThickness="1"
                        BoxShadow="0 24 70 0 #B3000000">
                    <DockPanel>

                        <!-- Header -->
                        <Grid DockPanel.Dock="Top"
                              ColumnDefinitions="*,Auto"
                              Margin="22,18,18,12">
                            <StackPanel Spacing="2">
                                <TextBlock Name="LblEditTitle"
                                           Text="Edit order"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                                <TextBlock Name="LblEditSubtitle"
                                           Text=""
                                           FontSize="12"
                                           Foreground="{StaticResource White40Brush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="step"
                                    Width="30" Height="30"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource White40Brush}"
                                    Click="OnCloseEdit">
                                <ctl:Icon Data="{StaticResource Icon.X}" Width="18" Height="18" />
                            </Button>
                        </Grid>

                        <!-- Footer: totals + save -->
                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="{StaticResource White06Brush}"
                                BorderThickness="0,1,0,0"
                                Padding="22,14,22,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Name="LblEditBreakdown"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{StaticResource White40Brush}" />
                                    <TextBlock Name="LblEditTotal"
                                               Text="₹0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <Button Classes="soft" Height="42" CornerRadius="14"
                                            Padding="18,0" Click="OnCloseEdit">
                                        <TextBlock Text="Discard" FontSize="13" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Name="BtnEditSave" Classes="brand" Height="42"
                                            CornerRadius="14" Padding="22,0" Click="OnSaveEdit">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ctl:Icon Data="{StaticResource Icon.Save}" Width="15" Height="15" />
                                            <TextBlock Name="LblEditSave" Text="Save changes"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Body -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,4,22,18" Spacing="18">

                                <!-- Order type -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ORDER TYPE" Classes="caption" />
                                    <Border CornerRadius="16" Padding="4"
                                            Background="{StaticResource White02Brush}"
                                            BorderBrush="{StaticResource White08Brush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,4,*,4,*">
                                            <Button Name="BtnEditDineIn" Grid.Column="0" Classes="segment active"
                                                    Content="Dine in" Click="OnEditDineIn" />
                                            <Button Name="BtnEditTakeaway" Grid.Column="2" Classes="segment"
                                                    Content="Takeaway" Click="OnEditTakeaway" />
                                            <Button Name="BtnEditDelivery" Grid.Column="4" Classes="segment"
                                                    Content="Delivery" Click="OnEditDelivery" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Customer + table -->
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="CUSTOMER NAME" Classes="caption" />
                                        <TextBox Name="TxtEditName" Watermark="Walk-in"
                                                 CornerRadius="12" Padding="12,10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="PHONE" Classes="caption" />
                                        <TextBox Name="TxtEditPhone" Watermark="Optional"
                                                 CornerRadius="12" Padding="12,10" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Name="PanelEditTable" Spacing="8">
                                    <TextBlock Text="TABLE" Classes="caption" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Name="EditTablesPanel" Orientation="Horizontal" Spacing="6" />
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Items -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ITEMS" Classes="caption" VerticalAlignment="Center" />
                                        <TextBlock Name="LblEditItemCount" Grid.Column="1"
                                                   Text="0 items" FontSize="11"
                                                   Foreground="{StaticResource White40Brush}" />
                                    </Grid>
                                    <StackPanel Name="EditLinesPanel" Spacing="6" />
                                    <TextBlock Name="LblEditNoLines"
                                               IsVisible="False"
                                               Text="Every item was removed. An order needs at least one line — cancel it instead."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource BrandBrush}" />
                                </StackPanel>

                                <!-- Add an item -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ADD AN ITEM" Classes="caption" />
                                    <TextBox Name="TxtEditItemSearch"
                                             Watermark="Search the menu…"
                                             CornerRadius="12" Padding="12,10">
                                        <TextBox.InnerLeftContent>
                                            <ctl:Icon Data="{StaticResource Icon.Search}"
                                                      Width="15" Height="15"
                                                      Foreground="{StaticResource White30Brush}"
                                                      Margin="2,0,8,0" />
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <StackPanel Name="EditSearchResults" Spacing="4" />
                                </StackPanel>

                                <!-- Discount + payment -->
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="DISCOUNT" Classes="caption" />
                                        <Border CornerRadius="14" Padding="3"
                                                Background="{StaticResource White02Brush}"
                                                BorderBrush="{StaticResource White08Brush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="*,3,*,3,*">
                                                <Button Name="BtnDiscNone" Grid.Column="0" Classes="segment active"
                                                        Content="None" Click="OnDiscountNone" />
                                                <Button Name="BtnDiscFlat" Grid.Column="2" Classes="segment"
                                                        Content="Amount" Click="OnDiscountFlat" />
                                                <Button Name="BtnDiscPct" Grid.Column="4" Classes="segment"
                                                        Content="Percent" Click="OnDiscountPercent" />
                                            </Grid>
                                        </Border>
                                        <TextBox Name="TxtEditDiscount"
                                                 Watermark="0"
                                                 IsVisible="False"
                                                 CornerRadius="12" Padding="12,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Text="PAYMENT" Classes="caption" />
                                        <Border CornerRadius="14" Padding="3"
                                                Background="{StaticResource White02Brush}"
                                                BorderBrush="{StaticResource White08Brush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="*,3,*,3,*,3,*">
                                                <Button Name="BtnPayNone" Grid.Column="0" Classes="segment active"
                                                        Content="Unpaid" Click="OnPayUnpaid" />
                                                <Button Name="BtnPayCash" Grid.Column="2" Classes="segment"
                                                        Content="Cash" Click="OnPayCash" />
                                                <Button Name="BtnPayUpi" Grid.Column="4" Classes="segment"
                                                        Content="UPI" Click="OnPayUpi" />
                                                <Button Name="BtnPayCard" Grid.Column="6" Classes="segment"
                                                        Content="Card" Click="OnPayCard" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Panel>
        </Panel>

        <!-- ═════════════════════════════════════════════════════════════
             COMPLETE ORDER PAYMENT MODAL OVERLAY (ORDERS PAGE)
             ═════════════════════════════════════════════════════════════ -->
        <Panel Name="CompleteOrderModalHost" IsVisible="False">
            <Border Background="{StaticResource ScrimBrush}" PointerPressed="OnCloseCompleteModal" />

            <Border Width="540" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="26"
                    ClipToBounds="True"
                    Background="#121212"
                    BorderBrush="{StaticResource White10Brush}"
                    BorderThickness="1"
                    BoxShadow="0 24 70 0 #B3000000">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="24,20,20,16" BorderBrush="{StaticResource White06Brush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Name="LblCompleteOrderHeader" Text="Complete Order" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="Select payment method, discount, and finalize order completion." FontSize="12" Foreground="{StaticResource White40Brush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Classes="step" Width="32" Height="32" Click="OnCloseCompleteModal">
                                <ctl:Icon Data="{StaticResource Icon.X}" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Border DockPanel.Dock="Bottom" Padding="24,16" BorderBrush="{StaticResource White06Brush}" BorderThickness="0,1,0,0" Background="{StaticResource White02Brush}">
                        <Grid ColumnDefinitions="*,12,*">
                            <Button Grid.Column="0" Content="Cancel" Classes="secondary" Height="44" CornerRadius="14" Click="OnCloseCompleteModal" />
                            <Button Name="BtnFinalizeCompleteOrder" Grid.Column="2" Classes="brand" Height="44" CornerRadius="14" Click="OnConfirmCompleteOrder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ctl:Icon Data="{StaticResource Icon.CircleCheckBig}" Width="16" Height="16" />
                                    <TextBlock Name="LblFinalizeCompleteText" Text="Complete Order" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20" Spacing="18">

                            <!-- Order Summary Card -->
                            <Border CornerRadius="16" Padding="18" Background="{StaticResource White03Brush}" BorderBrush="{StaticResource White08Brush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Foreground="{StaticResource White50Brush}" FontSize="13" />
                                    <TextBlock Name="LblCompSubtotal" Grid.Row="0" Grid.Column="1" Text="₹0" Foreground="White" FontSize="13" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax" Foreground="{StaticResource White50Brush}" FontSize="13" Margin="0,6,0,0" />
                                    <TextBlock Name="LblCompTax" Grid.Row="1" Grid.Column="1" Text="₹0" Foreground="White" FontSize="13" Margin="0,6,0,0" />

                                    <TextBlock Name="LblCompDiscountTitle" Grid.Row="2" Grid.Column="0" Text="Discount" Foreground="#10B981" FontSize="13" Margin="0,6,0,0" IsVisible="False" />
                                    <TextBlock Name="LblCompDiscountAmount" Grid.Row="2" Grid.Column="1" Text="-₹0" Foreground="#10B981" FontSize="13" Margin="0,6,0,0" IsVisible="False" />

                                    <TextBlock Name="LblCompRentalTitle" Grid.Row="3" Grid.Column="0" Text="Space Rental" Foreground="{StaticResource White50Brush}" FontSize="13" Margin="0,6,0,0" IsVisible="False" />
                                    <TextBlock Name="LblCompRentalAmount" Grid.Row="3" Grid.Column="1" Text="+₹0" Foreground="White" FontSize="13" Margin="0,6,0,0" IsVisible="False" />

                                    <Separator Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="{StaticResource White08Brush}" Margin="0,10" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="TOTAL PAYABLE" Classes="caption" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Name="LblCompTotalPayable" Grid.Row="5" Grid.Column="1" Text="₹0" FontSize="22" FontWeight="Bold" Foreground="White" />
                                </Grid>
                            </Border>

                            <!-- Discount Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="APPLY DISCOUNT" Classes="caption" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <ComboBox Name="CboCompDiscountType" CornerRadius="12" Padding="12,8" HorizontalAlignment="Stretch" SelectionChanged="OnCompDiscountTypeChanged">
                                        <ComboBoxItem Content="No Discount" IsSelected="True" />
                                        <ComboBoxItem Content="Percentage (%)" />
                                        <ComboBoxItem Content="Flat Amount (₹)" />
                                    </ComboBox>

                                    <TextBox Name="TxtCompDiscountValue" Grid.Column="1" Watermark="e.g. 10" CornerRadius="12" Padding="12,8" KeyUp="OnCompDiscountValueKeyUp" />
                                </Grid>
                            </StackPanel>

                            <!-- Space Rental Input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="SPACE RENTAL / EXTRA CHARGE (OPTIONAL)" Classes="caption" />
                                <TextBox Name="TxtCompSpaceRental" Watermark="0.00" CornerRadius="12" Padding="12,8" KeyUp="OnCompRentalKeyUp" />
                            </StackPanel>

                            <!-- Payment Method Selector -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="PAYMENT METHOD *" Classes="caption" />
                                <Grid ColumnDefinitions="*,8,*,8,*,8,*">
                                    <Button Name="BtnCompPayCash" Grid.Column="0" Classes="segment active" Padding="10,12" CornerRadius="14" Click="OnCompSelectPayCash">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ctl:Icon Data="{StaticResource Icon.Banknote}" Width="20" Height="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="Cash" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Name="BtnCompPayCard" Grid.Column="2" Classes="segment" Padding="10,12" CornerRadius="14" Click="OnCompSelectPayCard">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ctl:Icon Data="{StaticResource Icon.CreditCard}" Width="20" Height="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="Card" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Name="BtnCompPayUpi" Grid.Column="4" Classes="segment" Padding="10,12" CornerRadius="14" Click="OnCompSelectPayUpi">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ctl:Icon Data="{StaticResource Icon.QrCode}" Width="20" Height="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="UPI / QR" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Name="BtnCompPayCredit" Grid.Column="6" Classes="segment" Padding="10,12" CornerRadius="14" Click="OnCompSelectPayCredit">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ctl:Icon Data="{StaticResource Icon.Wallet}" Width="20" Height="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="Credit" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Cash Calculator (Visible when Cash selected) -->
                            <StackPanel Name="PanelCompCashTender" Spacing="10">
                                <Grid ColumnDefinitions="*,12,Auto">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="CASH TENDERED" Classes="caption" />
                                        <TextBox Name="TxtCompCashTendered" Watermark="0" CornerRadius="12" Padding="12,10" KeyUp="OnCompCashTenderedKeyUp" />
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="14" Padding="16,10" Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" VerticalAlignment="Bottom">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="CHANGE DUE" Classes="caption" Foreground="#10B981" />
                                            <TextBlock Name="LblCompChangeDue" Text="₹0" FontSize="16" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Quick Cash Pills -->
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Classes="chip" Content="Exact Amount" Margin="0,0,6,6" Click="OnCompQuickCashExact" />
                                    <Button Classes="chip" Content="+₹50" Margin="0,0,6,6" Click="OnCompQuickCashAdd50" />
                                    <Button Classes="chip" Content="+₹100" Margin="0,0,6,6" Click="OnCompQuickCashAdd100" />
                                    <Button Classes="chip" Content="+₹200" Margin="0,0,6,6" Click="OnCompQuickCashAdd200" />
                                    <Button Classes="chip" Content="+₹500" Margin="0,0,6,6" Click="OnCompQuickCashAdd500" />
                                    <Button Classes="chip" Content="+₹2000" Margin="0,0,6,6" Click="OnCompQuickCashAdd2000" />
                                </WrapPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
